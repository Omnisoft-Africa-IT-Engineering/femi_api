import logging
import re
from decimal import Decimal

from apps.femi_agent.schemas import ParsedOperationSchema
from apps.femi_agent.agent.executor import analyze_accounting_text, AgentExecutionError

logger = logging.getLogger(__name__)


# Mapping catégorie -> mots-clés (une seule source de vérité, facile à étendre)
CATEGORY_KEYWORDS = {
    "Transport": ["carburant", "essence", "taxi", "transport"],
    "Restauration": ["repas", "manger", "restaurant", "déjeuner"],
    "Loyer & Charges": ["loyer", "bureau", "local"],
}

PAYMENT_METHOD_KEYWORDS = {
    "MOBILE_MONEY": ["wave", "tmoney", "flooz", "orange", "om", "momo"],
    "BANK_TRANSFER": ["virement", "banque", "chèque", "rib"],
}


def run_ai_extraction(text_input: str) -> ParsedOperationSchema:
    """
    Analyse le texte utilisateur via l'agent LangChain (Ollama en local).
    Bascule automatiquement sur un analyseur local de secours (regex)
    si le LLM n'est pas disponible ou échoue.
    """
    try:
        return analyze_accounting_text(text_input)
    except AgentExecutionError as e:
        logger.warning(f"Extraction LLM échouée, bascule sur le fallback regex : {e}")
        return _fallback_parser(text_input)
    except Exception as e:
        # Sécurité supplémentaire : toute erreur inattendue (Ollama injoignable, etc.)
        # ne doit jamais faire planter le pipeline complet.
        logger.error(f"Erreur inattendue lors de l'extraction LLM : {e}")
        return _fallback_parser(text_input)


def _detect_category(text_lower: str, is_recette: bool) -> str:
    """Détecte la catégorie d'une opération à partir de mots-clés."""
    for category, keywords in CATEGORY_KEYWORDS.items():
        if any(kw in text_lower for kw in keywords):
            return category

    if is_recette:
        return "Vente de services / produits"

    return "Autre"


def _detect_payment_method(text_lower: str) -> str:
    """Détecte le mode de paiement à partir de mots-clés. Défaut : CASH."""
    for method, keywords in PAYMENT_METHOD_KEYWORDS.items():
        if any(kw in text_lower for kw in keywords):
            return method
    return "CASH"


def _fallback_parser(text_input: str) -> ParsedOperationSchema:
    """Analyseur local de secours (regex/mots-clés), utilisé si le LLM échoue."""
    text_lower = text_input.lower()
    is_recette = any(w in text_lower for w in ["vente", "reçu", "recette", "gain", "encaissement", "client"])
    transaction_type = "RECETTE" if is_recette else "DEPENSE"

    numbers = [Decimal(n.replace(",", ".")) for n in re.findall(r'\d+', text_input.replace(" ", ""))]
    amount = max(numbers) if numbers else Decimal("0")

    payment_method = _detect_payment_method(text_lower)
    category = _detect_category(text_lower, is_recette)

    return ParsedOperationSchema(
        transaction_type=transaction_type,
        amount_ttc=amount,
        amount_ht=amount,
        tax_amount=Decimal("0"),
        currency="XOF",
        category=category,
        payment_method=payment_method,
        description=text_input,
        confidence_score=0.80,
    )